<?xml version="1.0"?>
<extension key="com.joineryhq.eventbrite" type="module">
  <file>eventbrite</file>
  <name>Eventbrite Integration</name>
  <description>Provides synchronization to CiviCRM for participants and payments registered through Eventbrite.</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.eventbrite/</url>
    <url desc="Documentation">https://twomice.github.io/com.joineryhq.eventbrite/</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.eventbrite/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2021-04-20</releaseDate>
  <version>1.3.1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Developed by Joinery for Joseph Lacey and GIA.</comments>
  <civix>
    <namespace>CRM/Eventbrite</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Eventbrite\AutomaticUpgrader</upgrader>
</extension>
